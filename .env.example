# Domus environment variables. Copy to .env and adjust.
# Keep in sync with internal/app/config.go, internal/user/config.go and
# charts/values.yaml. Defaults shown are the in-code defaults.

# --- Server & Database (internal/app) ---
APP_PORT=8080
APP_LOG_LEVEL=info
APP_DB_URL=postgres://domus:domus@localhost:5432/domus?sslmode=disable
# Required (min 32 bytes). Generate with: openssl rand -hex 32
APP_SECRET=

# --- User / Auth (internal/user) ---
# Required to bootstrap the first super admin.
USER_SUPER_ADMIN_EMAIL=
USER_SUPER_ADMIN_NAME=Super Admin
# OAuth (optional)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- Sentry (backend: domus-api) ---
# Empty DSN disables Sentry.
APP_SENTRY_DSN=
APP_SENTRY_ENVIRONMENT=development
APP_SENTRY_RELEASE=

# --- Sentry (UI: domus-ui, read at ui build/dev time) ---
APP_SENTRY_UI_DSN=
# Source map upload at build time only; never commit a real token.
APP_SENTRY_AUTH_TOKEN=

# --- SMTP (optional; empty host falls back to LogOTPSender) ---
APP_SMTP_HOST=
APP_SMTP_PORT=587
APP_SMTP_USER=
APP_SMTP_PASS=
APP_SMTP_FROM="Domus <no-reply@example.com>"

# --- Telegram (optional; empty token disables Telegram channel) ---
APP_TELEGRAM_BOT_TOKEN=
APP_TELEGRAM_BOT_USERNAME=
APP_TELEGRAM_WEBHOOK_SECRET=

# --- GOWA / WhatsApp (optional; empty base URL disables WhatsApp channel) ---
# ponytail: APP_GOWA_DEVICE_ID and APP_GOWA_WEBHOOK_SECRET deferred to Phase 6 (MVP-6.4).
APP_GOWA_BASE_URL=
APP_GOWA_BASIC_USER=
APP_GOWA_BASIC_PASS=
